=twitter|elementId=https://twitter.com/nos|elementType=social\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M13.647 10.469 20.932 2h-1.726L12.88 9.353 7.827 2H2l7.64 11.12L2 22h1.726l6.68-7.765L15.743 22h5.828zm-2.365 2.748-.774-1.107-6.16-8.81H7l4.971 7.11.774 1.107 6.462 9.242h-2.652z\"></path></svg></a><a aria-label=\"Ga naar het NOS Facebook account\" class=\"sc-9610c20e-0 gHEInl sc-8404c505-1 hEvqka\" href=\"https://www.facebook.com/nos/\" rel=\"noreferrer noopener\" target=\"_blank\" data-tracking=\"eventType=navigation|eventName=open|eventContext=facebook|elementId=https://www.facebook.com/nos/|elementType=social\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M6 13.053v-4.27h3.542V5.64q0-2.682 1.444-4.16Q12.431-.001 14.833 0 16.875 0 18 .173v3.808h-2.18q-1.195 0-1.612.519-.416.519-.416 1.558v2.726h4.07l-.543 4.269h-3.527V24h-4.25V13.053z\"></path></svg></a><a aria-label=\"Ga naar het NOS Instagram account\" class=\"sc-9610c20e-0 gHEInl sc-8404c505-1 hEvqka\" href=\"https://www.instagram.com/nos/\" rel=\"noreferrer noopener\" target=\"_blank\" data-tracking=\"eventType=navigation|eventName=open|eventContext=instagram|elementId=https://www.instagram.com/nos/|elementType=social\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M18.704 6.82a1.33 1.33 0 1 1 0-2.66 1.33 1.33 0 0 1 0 2.66M12 18.063A6.07 6.07 0 0 1 5.937 12 6.07 6.07 0 0 1 12 5.936 6.07 6.07 0 0 1 18.064 12 6.07 6.07 0 0 1 12 18.063M18.3 0H5.7A5.706 5.706 0 0 0 0 5.7v12.6C0 21.443 2.557 24 5.7 24h12.6c3.143 0 5.7-2.557 5.7-5.7V5.7C24 2.557 21.443 0 18.3 0M12 7.736A4.27 4.27 0 0 0 7.737 12 4.27 4.27 0 0 0 12 16.264 4.27 4.27 0 0 0 16.263 12 4.27 4.27 0 0 0 12 7.737\"></path></svg></a><a aria-label=\"Ga naar het NOS Youtube account\" class=\"sc-9610c20e-0 gHEInl sc-8404c505-1 hEvqka\" href=\"https://www.youtube.com/nos/\" rel=\"noreferrer noopener\" target=\"_blank\" data-tracking=\"eventType=navigation|eventName=open|eventContext=youtube|elementId=https://www.youtube.com/nos/|elementType=social\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"m16.249 12.484-6.855 3.787c-.485.269-1.07-.097-1.07-.67V8.399c0-.558.56-.926 1.043-.685l6.854 3.416c.54.268.556 1.062.028 1.354M22.08 2.478s-2.152-.513-10.093-.476c-8.779.04-10.067.476-10.067.476C.86 2.478 0 3.331 0 4.382V19.62c0 1.05.86 1.904 1.92 1.904 0 0 2.565.481 10.067.476 7.862-.005 10.093-.476 10.093-.476 1.06 0 1.92-.853 1.92-1.904V4.382c0-1.051-.86-1.904-1.92-1.904\"></path></svg></a></div><div class=\"sc-7dd6bf2c-13 jBKERJ\"><small class=\"sc-7dd6bf2c-14 bVjlHE\">© NOS <!-- -->2024</small><a class=\"sc-7dd6bf2c-15 hwSzOw npo_cc_settings_link\" href=\"https://cookies.nos.nl/sites/NOS/nos.nl/settings.html\" data-tracking=\"eventType=navigation|eventName=open|elementId=cookieinstellingen|elementType=external-link\">Cookies</a><a href=\"https://over.nos.nl/organisatie/regelgeving/\" target=\"_blank\" data-tracking=\"eventType=navigation|eventName=open|elementId=voorwaarden|elementType=external-link\" class=\"sc-7dd6bf2c-15 hwSzOw\">Voorwaarden</a></div></div></div></footer></div><script id=\"__NEXT_DATA__\" type=\"application/json\">{\"props\":{\"pageProps\":{\"_sentryTraceData\":\"4020d4781b84fe739835518765f94fcc-f9f715e62390b6a0-0\",\"_sentryBaggage\":\"sentry-environment=production,sentry-release=1733903016868,sentry-public_key=3caf4fd1080f42859504caf5189fa266,sentry-trace_id=4020d4781b84fe739835518765f94fcc,sentry-sampled=false\",\"data\":{\"id\":2547635,\"bios\":[],\"type\":\"article\",\"keywords\":[\"Autosport\",\"Formule 1\"],\"title\":\"Winterstop Formule 1 na eerste jaar waarin zeven rijders meermaals wonnen\",\"description\":\"In 2024 wonnen zeven Formule 1-coureurs meerdere races. Dat gebeurde nog nooit in de vorige 74 seizoenen.\",\"pills\":[],\"publishedAt\":\"2024-12-09T06:13:12+0100\",\"modifiedAt\":\"2024-12-09T06:13:12+0100\",\"shareImageSrc\":\"https://cdn.nos.nl/image/2024/12/09/1167291/1024x576a.jpg\",\"items\":[{\"id\":\"50845773201987\",\"type\":\"text\",\"text\":\"Het langste Formule 1-seizoen uit de geschiedenis zit erop. Max Verstappen en Lando Norris waren de hoofdrolspelers van een seizoen dat meerdere fasen kende en diverse winnaars opleverde.\"},{\"id\":\"689318778114591\",\"type\":\"text\",\"text\":\"Zeven verschillende coureurs brachten in 2024 een Formule 1-race op hun naam, het grootste aantal sinds 2012. Dat ging bovendien gepaard met een record: nog nooit wonnen zeven rijders méérdere GP's in een jaar.\"},{\"id\":\"153998446707469\",\"type\":\"text\",\"text\":\"Verstappen kroonde zich twee weken geleden tot \\u003ca href=\\\"https://nos.nl/artikel/2545722-verstappen-rijdt-in-las-vegas-naar-vierde-wereldtitel-in-formule-1\\\" data-tracking=\\\"elementType=page|elementId=https://nos.nl/artikel/2545722-verstappen-rijdt-in-las-vegas-naar-vierde-wereldtitel-in-formule-1|eventType=navigation|eventName=open\\\" target=\\\"_self\\\"\\u003ewereldkampioen\\u003c/a\\u003e bij de rijders, McLaren veroverde zondag in Abu Dhabi tijdens de 24ste en laatste grand prix van het jaar de \\u003ca href=\\\"https://nos.nl/artikel/2547565-norris-wint-slotrace-formule-1-en-bezorgt-mclaren-constructeurstitel-verstappen-zesde\\\" data-tracking=\\\"elementType=page|elementId=https://nos.nl/artikel/2547565-norris-wint-slotrace-formule-1-en-bezorgt-mclaren-constructeurstitel-verstappen-zesde|eventType=navigation|eventName=open\\\" target=\\\"_self\\\"\\u003etitel bij de constructeurs\\u003c/a\\u003e met een zege van Lando Norris.\"},{\"id\":\"798212332324823\",\"type\":\"title\",\"title\":\"Zegereeks Verstappen\"},{\"id\":\"668019563063272\",\"type\":\"text\",\"text\":\"Verstappen begon het seizoen met dezelfde dominantie als waarmee hij 2023 afsloot. Hij won zeven van de eerste tien races. De zeges in Bahrein, Saudi-Arabië, Japan en China werden met ruime voorsprong behaald. Voor de overwinningen in Imola (gevecht met Norris), Canada (regen) en Spanje (opnieuw tegen Norris) moest hij harder werken.\"},{\"id\":\"423703914106451\",\"type\":\"text\",\"text\":\"In aanloop naar de zomer werd McLaren steeds sterker. Norris won in Miami, in mei, zijn eerste grand prix. Later domineerde de Brit ook in Zandvoort en Singapore. Met zijn overwinning van afgelopen zondag in Abu Dhabi kwam zijn teller op vier.\"},{\"id\":\"938575174285896\",\"type\":\"text\",\"text\":\"Ook Norris' teamgenoot Oscar Piastri werd een winnaar in de Formule 1. In Hongarije kreeg hij de winst 'cadeau' toen Norris voor hem aan de kant ging. In Azerbeidzjan pakte Piastri geheel op eigen kracht de overwinning.\"},{\"id\":\"188411673549772\",\"type\":\"text\",\"text\":\"Verstappen won pas vorige maand weer. De triomf in de regen in São Paulo was wel meteen de \\u003cem\\u003evorentscheidung\\u003c/em\\u003e, waarna hij het karwei in Las Vegas afmaakte. In Qatar ging Verstappen voor de negende keer dit seizoen als eerste over de finish.\"},{\"id\":\"879737691892949\",\"type\":\"image\",\"image\":{\"imagesByRatio\":{\"4:3\":[{\"width\":96,\"height\":72,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167293/96x72a.jpg\"}},{\"width\":192,\"height\":144,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167293/192x144a.jpg\"}},{\"width\":288,\"height\":216,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167293/288x216a.jpg\"}},{\"width\":384,\"height\":288,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167293/384x288a.jpg\"}},{\"width\":480,\"height\":360,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167293/480x360a.jpg\"}},{\"width\":576,\"height\":432,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167293/576x432a.jpg\"}},{\"width\":768,\"height\":576,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167293/768x576a.jpg\"}},{\"width\":960,\"height\":720,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167293/960x720a.jpg\"}},{\"width\":1152,\"height\":864,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167293/1152x864a.jpg\"}},{\"width\":1440,\"height\":1080,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167293/1440x1080a.jpg\"}},{\"width\":1920,\"height\":1440,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167293/1920x1440a.jpg\"}},{\"width\":2400,\"height\":1800,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167293/2400x1800a.jpg\"}},{\"width\":2880,\"height\":2160,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167293/2880x2160a.jpg\"}}],\"16:9\":[{\"width\":128,\"height\":72,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167293/128x72a.jpg\"}},{\"width\":256,\"height\":144,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167293/256x144a.jpg\"}},{\"width\":384,\"height\":216,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167293/384x216a.jpg\"}},{\"width\":512,\"height\":288,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167293/512x288a.jpg\"}},{\"width\":640,\"height\":360,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167293/640x360a.jpg\"}},{\"width\":768,\"height\":432,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167293/768x432a.jpg\"}},{\"width\":1024,\"height\":576,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167293/1024x576a.jpg\"}},{\"width\":1280,\"height\":720,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167293/1280x720a.jpg\"}},{\"width\":1536,\"height\":864,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167293/1536x864a.jpg\"}},{\"width\":1920,\"height\":1080,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167293/1920x1080a.jpg\"}},{\"width\":2560,\"height\":1440,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167293/2560x1440a.jpg\"}},{\"width\":3200,\"height\":1800,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167293/3200x1800a.jpg\"}},{\"width\":3840,\"height\":2160,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167293/3840x2160a.jpg\"}}]},\"description\":\"Charles Leclerc viert feest na zijn zege op Monza\",\"copyright\":\"AFP\",\"sizes\":\"(min-width: 786px) 786px, 100vw\"}},{\"id\":\"897112590116787\",\"type\":\"text\",\"text\":\"Toch was er van een echte tweestrijd geen sprake in 2024. Misschien was het ook wel de redding voor Verstappen en Red Bull dat niet één, maar meer teams aanspraak maakten op dagsuccessen.\"},{\"id\":\"187003466454281\",\"type\":\"text\",\"text\":\"Carlos Sainz, die in februari al hoorde dat hij na dit seizoen bij Ferrari plaats moet maken voor Lewis Hamilton, profiteerde in Australië van het uitvallen van Verstappen en won in Melbourne. In het najaar hielp de Spanjaard in Mexico de 'Scuderia' opnieuw aan een overwinning.\"},{\"id\":\"885234255766685\",\"type\":\"text\",\"text\":\"Zijn teamgenoot Charles Leclerc kende ook een sterk seizoen. Eindelijk won hij zijn thuisrace in Monaco. In september maakte de Monegask heel Italië gek door op Monza te stunten. Hoewel McLaren sneller leek, pakte Leclerc het initiatief door een pitstop minder te maken.\"},{\"id\":\"663854407473945\",\"type\":\"text\",\"text\":\"Het was nagelbijten in de slotronden, maar Leclerc was snel genoeg op de oude banden onder zijn Ferrari en passeerde als eerste de lijn. Twee thuiszeges in één seizoen dus, zou je kunnen zeggen.\"},{\"id\":\"861251909076244\",\"type\":\"text\",\"text\":\"In Texas pakte Leclerc soeverein zijn derde winst van het jaar.\"},{\"id\":\"922700456098871\",\"type\":\"title\",\"title\":\"Ook Mercedes boekt succes\"},{\"id\":\"163377296932777\",\"type\":\"text\",\"text\":\"Niet alleen Ferrari snoepte punten af van Red Bull en McLaren. Mercedes kende een zeer lastige start van het seizoen: de snelheid van de bolide viel tegen. Pas in de zomer konden de 'Zilverpijlen' mee en ineens stond de Duitse formatie als een huis.\"},{\"id\":\"908999106528940\",\"type\":\"text\",\"text\":\"In Oostenrijk profiteerde George Russell van een \\u003cem\\u003eclash \\u003c/em\\u003etussen Verstappen en Norris, die vochten om de leiding van de race. Russell was de lachende derde en nam de grootste bokaal mee naar huis. In Las Vegas won Russell opnieuw.\"},{\"id\":\"922888101651894\",\"type\":\"image\",\"image\":{\"imagesByRatio\":{\"4:3\":[{\"width\":96,\"height\":72,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167294/96x72a.jpg\"}},{\"width\":192,\"height\":144,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167294/192x144a.jpg\"}},{\"width\":288,\"height\":216,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167294/288x216a.jpg\"}},{\"width\":384,\"height\":288,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167294/384x288a.jpg\"}},{\"width\":480,\"height\":360,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167294/480x360a.jpg\"}},{\"width\":576,\"height\":432,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167294/576x432a.jpg\"}},{\"width\":768,\"height\":576,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167294/768x576a.jpg\"}},{\"width\":960,\"height\":720,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167294/960x720a.jpg\"}},{\"width\":1152,\"height\":864,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167294/1152x864a.jpg\"}},{\"width\":1440,\"height\":1080,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167294/1440x1080a.jpg\"}},{\"width\":1920,\"height\":1440,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167294/1920x1440a.jpg\"}},{\"width\":2400,\"height\":1800,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167294/2400x1800a.jpg\"}},{\"width\":2880,\"height\":2160,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167294/2880x2160a.jpg\"}}],\"16:9\":[{\"width\":128,\"height\":72,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167294/128x72a.jpg\"}},{\"width\":256,\"height\":144,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167294/256x144a.jpg\"}},{\"width\":384,\"height\":216,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167294/384x216a.jpg\"}},{\"width\":512,\"height\":288,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167294/512x288a.jpg\"}},{\"width\":640,\"height\":360,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167294/640x360a.jpg\"}},{\"width\":768,\"height\":432,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167294/768x432a.jpg\"}},{\"width\":1024,\"height\":576,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167294/1024x576a.jpg\"}},{\"width\":1280,\"height\":720,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167294/1280x720a.jpg\"}},{\"width\":1536,\"height\":864,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167294/1536x864a.jpg\"}},{\"width\":1920,\"height\":1080,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167294/1920x1080a.jpg\"}},{\"width\":2560,\"height\":1440,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167294/2560x1440a.jpg\"}},{\"width\":3200,\"height\":1800,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167294/3200x1800a.jpg\"}},{\"width\":3840,\"height\":2160,\"url\":{\"jpg\":\"https://cdn.nos.nl/image/2024/12/09/1167294/3840x2160a.jpg\"}}]},\"description\":\"Lewis Hamilton won zijn thuisrace\",\"copyright\":\"ANP\",\"sizes\":\"(min-width: 786px) 786px, 100vw\"}},{\"id\":\"707283579872402\",\"type\":\"text\",\"text\":\"Bijna had Russell drie keer gewonnen. Sterker: ook in België kwam de Engelsman als eerste over de streep. Vanwege een overtreding van het technisch reglement werd hij echter gediskwalificeerd.\"},{\"id\":\"377931741158079\",\"type\":\"text\",\"text\":\"Zijn teamgenoot Hamilton profiteerde daarvan. Het was niet de mooiste zege in de carrière van de zevenvoudig wereldkampioen, maar een paar weken eerder had Hamilton wel een race gereden die minstens bij zijn top tien-zeges thuishoort.\"},{\"id\":\"377965653814687\",\"type\":\"text\",\"text\":\"Op een kletsnat Silverstone won Hamilton voor de negende keer zijn thuisrace: een record. De Brit haalde zijn teamgenoot Russell in, profiteerde van slecht getimede pitstops bij McLaren en hield Verstappen in de slotfase knap achter zich. Na de finish vloeiden de tranen bij Hamilton, zijn engineer Peter Bonnington en bij vele autosportfans over de wereld.\"},{\"id\":\"582871506553432\",\"type\":\"title\",\"title\":\"Melbourne, 16 maart 2025\"},{\"id\":\"31464098944009\",\"type\":\"text\",\"text\":\"Hoe de onderlinge verhoudingen volgend jaar liggen, weten we op 16 maart als in Melbourne de eerste race van het jaar wordt gereden. 2025 wordt het laatste jaar van de huidige reglementen, waardoor de bolides hoofdzakelijk doorontwikkelingen worden van de auto's van dit seizoen.\"},{\"id\":\"530656111834648\",\"type\":\"text\",\"text\":\"Of er één team bovenuit zal steken, valt natuurlijk nu nog niet te zeggen, maar stabiele reglementen zorgden in het verleden vaker voor spannende seizoenen.\"},{\"type\":\"table\",\"table\":\"\\u003ctable\\u003e \\u003cthead\\u003e \\u003ctr\\u003e \\u003ctd\\u003eGrand Prix\\u003c/td\\u003e \\u003ctd\\u003eWinnaar\\u003c/td\\u003e \\u003c/tr\\u003e \\u003c/thead\\u003e \\u003ctbody\\u003e \\u003ctr\\u003e \\u003ctd\\u003e1. \\u003ca href=\\\"https://nos.nl/artikel/2511144-verstappen-begint-nieuw-formule-1-seizoen-met-overtuigende-zege-in-bahrein\\\" data-tracking=\\\"elementType=page|elementId=https://nos.nl/artikel/2511144-verstappen-begint-nieuw-formule-1-seizoen-met-overtuigende-zege-in-bahrein|eventType=navigation|eventName=open\\\" target=\\\"_self\\\"\\u003eBahrein\\u003c/a\\u003e\\u003c/td\\u003e \\u003ctd\\u003eMax Verstappen (Red Bull)\\u003c/td\\u003e \\u003c/tr\\u003e \\u003ctr\\u003e \\u003ctd\\u003e2. \\u003ca href=\\\"https://nos.nl/artikel/2512126-perikelen-red-bull-deren-verstappen-niet-ook-winst-in-saudi-arabie\\\" data-tracking=\\\"elementType=page|elementId=https://nos.nl/artikel/2512126-perikelen-red-bull-deren-verstappen-niet-ook-winst-in-saudi-arabie|eventType=navigation|eventName=open\\\" target=\\\"_self\\\"\\u003eSaudi-Arabië\\u003c/a\\u003e\\u003c/td\\u003e \\u003ctd\\u003eMax Verstappen (Red Bull)\\u003c/td\\u003e \\u003c/tr\\u003e \\u003ctr\\u003e \\u003ctd\\u003e3. \\u003ca href=\\\"https://nos.nl/artikel/2513979-verstappen-valt-al-snel-uit-met-rokende-auto-sainz-wint-gp-australie\\\" data-tracking=\\\"elementType=page|elementId=https://nos.nl/artikel/2513979-verstappen-valt-al-snel-uit-met-rokende-auto-sainz-wint-gp-australie|eventType=navigation|eventName=open\\\" target=\\\"_self\\\"\\u003eAustralië\\u003c/a\\u003e\\u003c/td\\u003e \\u003ctd\\u003eCarlos Sainz jr. (Ferrari)\\u003c/td\\u003e \\u003c/tr\\u003e \\u003ctr\\u003e \\u003ctd\\u003e4. \\u003ca href=\\\"https://nos.nl/artikel/2515824-soevereine-verstappen-pakt-in-japan-de-draad-weer-op\\\" data-tracking=\\\"elementType=page|elementId=https://nos.nl/artikel/2515824-soevereine-verstappen-pakt-in-japan-de-draad-weer-op|eventType=navigation|eventName=open\\\" target=\\\"_self\\\"\\u003eJapan\\u003c/a\\u003e\\u003c/td\\u003e \\u003ctd\\u003eMax Verstappen (Red Bull)\\u003c/td\\u003e \\u003c/tr\\u003e \\u003ctr\\u003e \\u003ctd\\u003e5. \\u003ca href=\\\"https://nos.nl/artikel/2517590-superieure-verstappen-boekt-zijn-eerste-grand-prix-zege-in-china\\\" data-tracking=\\\"elementType=page|elementId=https://nos.nl/artikel/2517590-superieure-verstappen-boekt-zijn-eerste-grand-prix-zege-in-china|eventType=navigation|eventName=open\\\" target=\\\"_self\\\"\\u003eChina\\u003c/a\\u003e\\u003c/td\\u003e \\u003ctd\\u003eMax Verstappen (Red Bull)\\u003c/td\\u003e \\u003c/tr\\u003e \\u003ctr\\u003e \\u003ctd\\u003e6. \\u003ca href=\\\"https://nos.nl/artikel/2519425-eerste-formule-1-zege-norris-na-curieuze-safety-car-verstappen-tweede-in-miami\\\" data-tracking=\\\"elementType=page|elementId=https://nos.nl/artikel/2519425-eerste-formule-1-zege-norris-na-curieuze-safety-car-verstappen-tweede-in-miami|eventType=navigation|eventName=open\\\" target=\\\"_self\\\"\\u003eMiami\\u003c/a\\u003e\\u003c/td\\u003e \\u003ctd\\u003eLando Norris (McLaren)\\u003c/td\\u003e \\u003c/tr\\u003e \\u003ctr\\u003e \\u003ctd\\u003e7. \\u003ca href=\\\"https://nos.nl/artikel/2521061-verstappen-boekt-derde-zege-in-imola-na-onverwacht-spannende-slotfase\\\" data-tracking=\\\"elementType=page|elementId=https://nos.nl/artikel/2521061-verstappen-boekt-derde-zege-in-imola-na-onverwacht-spannende-slotfase|eventType=navigation|eventName=open\\\" target=\\\"_self\\\"\\u003eEmilia-Romagna\\u003c/a\\u003e\\u003c/td\\u003e \\u003ctd\\u003eMax Verstappen (Red Bull)\\u003c/td\\u003e \\u003c/tr\\u003e \\u003ctr\\u003e \\u003ctd\\u003e8. \\u003ca href=\\\"https://nos.nl/artikel/2521971-leclerc-wint-in-monaco-eindelijk-gp-voor-eigen-publiek-verstappen-zesde\\\" data-tracking=\\\"elementType=page|elementId=https://nos.nl/artikel/2521971-leclerc-wint-in-monaco-eindelijk-gp-voor-eigen-publiek-verstappen-zesde|eventType=navigation|eventName=open\\\" target=\\\"_self\\\"\\u003eMonaco\\u003c/a\\u003e\\u003c/td\\u003e \\u003ctd\\u003eCharles Leclerc (Ferrari)\\u003c/td\\u003e \\u003c/tr\\u003e \\u003ctr\\u003e \\u003ctd\\u003e9. \\u003ca href=\\\"https://nos.nl/artikel/2523834-verstappen-snelste-in-regenachtige-gp-van-canada-vol-incidenten\\\" data-tracking=\\\"elementType=page|elementId=https://nos.nl/artikel/2523834-verstappen-snelste-in-regenachtige-gp-van-canada-vol-incidenten|eventType=navigation|eventName=open\\\" target=\\\"_self\\\"\\u003eCanada\\u003c/a\\u003e\\u003c/td\\u003e \\u003ctd\\u003eMax Verstappen (Red Bull)\\u003c/td\\u003e \\u003c/tr\\u003e \\u003ctr\\u003e \\u003ctd\\u003e10. \\u003ca href=\\\"https://nos.nl/artikel/2525820-verstappen-houdt-norris-achter-zich-en-boekt-in-spanje-zevende-zege-dit-seizoen\\\" data-tracking=\\\"elementType=page|elementId=https://nos.nl/artikel/2525820-verstappen-houdt-norris-achter-zich-en-boekt-in-spanje-zevende-zege-dit-seizoen|eventType=navigation|eventName=open\\\" target=\\\"_self\\\"\\u003eSpanje\\u003c/a\\u003e\\u003c/td\\u003e \\u003ctd\\u003eMax Verstappen (Red Bull)\\u003c/td\\u003e \\u003c/tr\\u003e \\u003ctr\\u003e \\u003ctd\\u003e11. \\u003ca href=\\\"https://nos.nl/artikel/2526756-verstappen-en-norris-schakelen-elkaar-uit-russell-pakt-winst-in-oostenrijk\\\" data-tracking=\\\"elementType=page|elementId=https://nos.nl/artikel/2526756-verstappen-en-norris-schakelen-elkaar-uit-russell-pakt-winst-in-oostenrijk|eventType=navigation|eventName=open\\\" target=\\\"_self\\\"\\u003eOostenrijk\\u003c/a\\u003e\\u003c/td\\u003e \\u003ctd\\u003eGeorge Russell (Mercedes)\\u003c/td\\u003e \\u003c/tr\\u003e \\u003ctr\\u003e \\u003ctd\\u003e12. \\u003ca href=\\\"https://nos.nl/artikel/2527876-hamilton-wint-bloedstollende-gp-van-groot-brittannie-inhaalrace-verstappen-net-te-laat\\\" data-tracking=\\\"elementType=page|elementId=https://nos.nl/artikel/2527876-hamilton-wint-bloedstollende-gp-van-groot-brittannie-inhaalrace-verstappen-net-te-laat|eventType=navigation|eventName=open\\\" target=\\\"_self\\\"\\u003eGroot-Brittannië\\u003c/a\\u003e\\u003c/td\\u003e \\u003ctd\\u003eLewis Hamilton (Mercedes)\\u003c/td\\u003e \\u003c/tr\\u003e \\u003ctr\\u003e \\u003ctd\\u003e13. \\u003ca href=\\\"https://nos.nl/artikel/2529774-piastri-wint-in-hongarije-ondanks-trammelant-bij-mclaren-vloekende-verstappen-vijfde\\\" data-tracking=\\\"elementType=page|elementId=https://nos.nl/artikel/2529774-piastri-wint-in-hongarije-ondanks-trammelant-bij-mclaren-vloekende-verstappen-vijfde|eventType=navigation|eventName=open\\\" target=\\\"_self\\\"\\u003eHongarije\\u003c/a\\u003e\\u003c/td\\u003e \\u003ctd\\u003eOscar Piastri (McLaren)\\u003c/td\\u003e \\u003c/tr\\u003e \\u003ctr\\u003e \\u003ctd\\u003e14. \\u003ca href=\\\"https://nos.nl/artikel/2530626-russell-raakt-zege-kwijt-door-te-lichte-auto-teamgenoot-hamilton-wint-gp-belgie\\\" data-tracking=\\\"elementType=page|elementId=https://nos.nl/artikel/2530626-russell-raakt-zege-kwijt-door-te-lichte-au