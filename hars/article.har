            "size": -1,
            "mimeType": "text/html; charset=utf-8",
            "text": "<!DOCTYPE html><html lang=\"nl\"><head><meta charSet=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1\" name=\"viewport\"/><style>\n    #nprogress {\n      pointer-events: none;\n    }\n    #nprogress .bar {\n      background: #e61e14;\n      position: fixed;\n      z-index: 9999;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 3px;\n    }\n    #nprogress .peg {\n      display: block;\n      position: absolute;\n      right: 0px;\n      width: 100px;\n      height: 100%;\n      box-shadow: 0 0 10px #e61e14, 0 0 5px #e61e14;\n      opacity: 1;\n      -webkit-transform: rotate(3deg) translate(0px, -4px);\n      -ms-transform: rotate(3deg) translate(0px, -4px);\n      transform: rotate(3deg) translate(0px, -4px);\n    }\n    #nprogress .spinner {\n      display: block;\n      position: fixed;\n      z-index: 1031;\n      top: 15px;\n      right: 15px;\n    }\n    #nprogress .spinner-icon {\n      width: 18px;\n      height: 18px;\n      box-sizing: border-box;\n      border: solid 2px transparent;\n      border-top-color: #e61e14;\n      border-left-color: #e61e14;\n      border-radius: 50%;\n      -webkit-animation: nprogresss-spinner 400ms linear infinite;\n      animation: nprogress-spinner 400ms linear infinite;\n    }\n    .nprogress-custom-parent {\n      overflow: hidden;\n      position: relative;\n    }\n    .nprogress-custom-parent #nprogress .spinner,\n    .nprogress-custom-parent #nprogress .bar {\n      position: absolute;\n    }\n    @-webkit-keyframes nprogress-spinner {\n      0% {\n        -webkit-transform: rotate(0deg);\n      }\n      100% {\n        -webkit-transform: rotate(360deg);\n      }\n    }\n    @keyframes nprogress-spinner {\n      0% {\n        transform: rotate(0deg);\n      }\n      100% {\n        transform: rotate(360deg);\n      }\n    }\n  </style><title>Winterstop Formule 1 na eerste jaar waarin zeven rijders meermaals wonnen</title><link href=\"https://nos.nl/l/2547635\" rel=\"canonical\"/><meta content=\"In 2024 wonnen zeven Formule 1-coureurs meerdere races. Dat gebeurde nog nooit in de vorige 74 seizoenen.\" name=\"description\"/><meta content=\"Winterstop Formule 1 na eerste jaar waarin zeven rijders meermaals wonnen\" name=\"title\"/><meta content=\"Autosport, Formule 1\" data-testid=\"keywords\" name=\"keywords\"/><meta content=\"article\" property=\"og:type\"/><meta content=\"https://nos.nl/artikel/2547635\" property=\"og:url\"/><meta content=\"Winterstop Formule 1 na eerste jaar waarin zeven rijders meermaals wonnen\" property=\"og:title\"/><meta content=\"In 2024 wonnen zeven Formule 1-coureurs meerdere races. Dat gebeurde nog nooit in de vorige 74 seizoenen.\" property=\"og:description\"/><meta content=\"https://cdn.nos.nl/image/2024/12/09/1167291/1024x576a.jpg\" property=\"og:image\"/><meta content=\"1200\" property=\"og:image:width\"/><meta content=\"630\" property=\"og:image:height\"/><meta content=\"summary_large_image\" property=\"twitter:card\"/><meta content=\"@NOS\" property=\"twitter:site\"/><meta content=\"https://cdn.nos.nl/image/2024/12/09/1167291/1024x576a.jpg\" name=\"thumbnail\"/><meta content=\"https://nos.nl/artikel/2547635\" property=\"twitter:url\"/><meta content=\"Winterstop Formule 1 na eerste jaar waarin zeven rijders meermaals wonnen\" property=\"twitter:title\"/><meta content=\"In 2024 wonnen zeven Formule 1-coureurs meerdere races. Dat gebeurde nog nooit in de vorige 74 seizoenen.\" data-testid=\"twitterdescription\" property=\"twitter:description\"/><meta content=\"https://cdn.nos.nl/image/2024/12/09/1167291/1024x576a.jpg\" property=\"twitter:image\"/><meta content=\"2024-12-09T06:13:12+0100\" property=\"og:article:published_time\"/><meta content=\"2024-12-09T06:13:12+0100\" property=\"og:article:modified_time\"/><meta content=\"Autosport, Formule 1\" property=\"og:article:tag\"/><link href=\"https://static.nos.nl/img/favicon/apple-touch-icon.png\" rel=\"apple-touch-icon\" sizes=\"180x180\"/><link href=\"https://static.nos.nl/img/favicon/favicon-32x32.png\" rel=\"icon\" sizes=\"32x32\" type=\"image/png\"/><link href=\"https://static.nos.nl/img/favicon/favicon-16x16.png\" rel=\"icon\" sizes=\"16x16\" type=\"image/png\"/><link color=\"#e61e14\" href=\"https://static.nos.nl/img/favicon/safari-pinned-tab.svg\" rel=\"mask-icon\"/><link href=\"https://static.nos.nl/img/favicon/favicon.ico\" rel=\"shortcut icon\"/><meta content=\"NOS.nl\" name=\"apple-mobile-web-app-title\"/><meta content=\"NOS.nl\" name=\"application-name\"/><meta content=\"#ffffff\" name=\"msapplication-TileColor\"/><meta content=\"#ffffff\" name=\"theme-color\"/><link href=\"/static/site.webmanifest.light\" rel=\"manifest\"/><meta content=\"/static/browserconfig.xml\" name=\"msapplication-config\"/><script type=\"application/ld+json\">{\"@context\":\"http://schema.org\",\"@type\":[\"NewsArticle\",\"WebPage\"],\"identifier\":2547635,\"url\":\"https://nos.nl/l/2547635\",\"publisher\":{\"@type\":\"Organization\",\"name\":\"NOS Sport\",\"logo\":\"https://static.nos.nl/img/nos/nos-social.jpg\"},\"headline\":\"Winterstop Formule 1 na eerste jaar waarin zeven rijders meermaals wonnen\",\"description\":\"In 2024 wonnen zeven Formule 1-coureurs meerdere races. Dat gebeurde nog nooit in de vorige 74 seizoenen.\",\"mainEntityOfPage\":\"https://nos.nl/l/2547635\",\"image\":{\"@type\":\"ImageObject\",\"url\":\"https://cdn.nos.nl/image/2024/12/09/1167291/1024x576a.jpg\"},\"dateCreated\":\"2024-12-09T06:13:12+0100\",\"datePublished\":\"2024-12-09T06:13:12+0100\",\"dateModified\":\"2024-12-09T06:13:12+0100\",\"isAccessibleForFree\":true,\"sdPublisher\":{\"@type\":\"Organization\",\"name\":\"NOS\",\"logo\":\"https://static.nos.nl/img/nos/nos-social.jpg\"},\"inLanguage\":[{\"@type\":\"Language\",\"name\":\"Dutch\"}],\"keywords\":[\"Autosport\",\"Formule 1\"],\"articleBody\":\"Het langste Formule 1-seizoen uit de geschiedenis zit erop. Max Verstappen en Lando Norris waren de hoofdrolspelers van een seizoen dat meerdere fasen kende en diverse winnaars opleverde. Zeven verschillende coureurs brachten in 2024 een Formule 1-race op hun naam, het grootste aantal sinds 2012. Dat ging bovendien gepaard met een record: nog nooit wonnen zeven rijders méérdere GP's in een jaar. Verstappen kroonde zich twee weken geleden tot wereldkampioen bij de rijders, McLaren veroverde zondag in Abu Dhabi tijdens de 24ste en laatste grand prix van het jaar de titel bij de constructeurs met een zege van Lando Norris.  Verstappen begon het seizoen met dezelfde dominantie als waarmee hij 2023 afsloot. Hij won zeven van de eerste tien races. De zeges in Bahrein, Saudi-Arabië, Japan en China werden met ruime voorsprong behaald. Voor de overwinningen in Imola (gevecht met Norris), Canada (regen) en Spanje (opnieuw tegen Norris) moest hij harder werken. In aanloop naar de zomer werd McLaren steeds sterker. Norris won in Miami, in mei, zijn eerste grand prix. Later domineerde de Brit ook in Zandvoort en Singapore. Met zijn overwinning van afgelopen zondag in Abu Dhabi kwam zijn teller op vier. Ook Norris' teamgenoot Oscar Piastri werd een winnaar in de Formule 1. In Hongarije kreeg hij de winst 'cadeau' toen Norris voor hem aan de kant ging. In Azerbeidzjan pakte Piastri geheel op eigen kracht de overwinning. Verstappen won pas vorige maand weer. De triomf in de regen in São Paulo was wel meteen de vorentscheidung, waarna hij het karwei in Las Vegas afmaakte. In Qatar ging Verstappen voor de negende keer dit seizoen als eerste over de finish.  Toch was er van een echte tweestrijd geen sprake in 2024. Misschien was het ook wel de redding voor Verstappen en Red Bull dat niet één, maar meer teams aanspraak maakten op dagsuccessen. Carlos Sainz, die in februari al hoorde dat hij na dit seizoen bij Ferrari plaats moet maken voor Lewis Hamilton, profiteerde in Australië van het uitvallen van Verstappen en won in Melbourne. In het najaar hielp de Spanjaard in Mexico de 'Scuderia' opnieuw aan een overwinning. Zijn teamgenoot Charles Leclerc kende ook een sterk seizoen. Eindelijk won hij zijn thuisrace in Monaco. In september maakte de Monegask heel Italië gek door op Monza te stunten. Hoewel McLaren sneller leek, pakte Leclerc het initiatief door een pitstop minder te maken. Het was nagelbijten in de slotronden, maar Leclerc was snel genoeg op de oude banden onder zijn Ferrari en passeerde als eerste de lijn. Twee thuiszeges in één seizoen dus, zou je kunnen zeggen. In Texas pakte Leclerc soeverein zijn derde winst van het jaar.  Niet alleen Ferrari snoepte punten af van Red Bull en McLaren. Mercedes kende een zeer lastige start van het seizoen: de snelheid van de bolide viel tegen. Pas in de zomer konden de 'Zilverpijlen' mee en ineens stond de Duitse formatie als een huis. In Oostenrijk profiteerde George Russell van een clash tussen Verstappen en Norris, die vochten om de leiding van de race. Russell was de lachende derde en nam de grootste bokaal mee naar huis. In Las Vegas won Russell opnieuw.  Bijna had Russell drie keer gewonnen. Sterker: ook in België kwam de Engelsman als eerste over de streep. Vanwege een overtreding van het technisch reglement werd hij echter gediskwalificeerd. Zijn teamgenoot Hamilton profiteerde daarvan. Het was niet de mooiste zege in de carrière van de zevenvoudig wereldkampioen, maar een paar weken eerder had Hamilton wel een race gereden die minstens bij zijn top tien-zeges thuishoort. Op een kletsnat Silverstone won Hamilton voor de negende keer zijn thuisrace: een record. De Brit haalde zijn teamgenoot Russell in, profiteerde van slecht getimede pitstops bij McLaren en hield Verstappen in de slotfase knap achter zich. Na de finish vloeiden de tranen bij Hamilton, zijn engineer Peter Bonnington en bij vele autosportfans over de wereld.  Hoe de onderlinge verhoudingen volgend jaar liggen, weten we op 16 maart als in Melbourne de eerste race van het jaar wordt gereden. 2025 wordt het laatste jaar van de huidige reglementen, waardoor de bolides hoofdzakelijk doorontwikkelingen worden van de auto's van dit seizoen. Of er één team bovenuit zal steken, valt natuurlijk nu nog niet te zeggen, maar stabiele reglementen zorgden in het verleden vaker voor spannende seizoenen.  \",\"articleSection\":[\"Autosport\",\"Formule 1\"]}</script><meta name=\"next-head-count\" content=\"37\"/><meta content=\"PFlpDv56X7yQ8CtMDAxvMIyOWtfO8puTcDbndM0veTY\" name=\"google-site-verification\"/><meta content=\"NOS\" name=\"app-name\"/><meta content=\"app-id=516491461\" name=\"apple-itunes-app\"/><meta content=\"app-id=nl.nos.app\" name=\"google-play-app\"/><script>var hasWindowAndDocument = !!(typeof window !== 'undefined' && document);\n            if (hasWindowAndDocument && !!window.MSInputMethodContext && !!document.documentMode) {\n              if (window.location.pathname !== '/geen-ondersteuning') {\n                window.location.replace(window.location.origin + '/geen-ondersteuning');\n              }\n            }</script><link rel=\"preload\" href=\"/_next/static/css/bfbc09307378af05.css\" as=\"style\"/><link rel=\"stylesheet\" href=\"/_next/static/css/bfbc09307378af05.css\" data-n-p=\"\"/><noscript data-n-css=\"\"></noscript><script defer=\"\" nomodule=\"\" src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\"></script><script src=\"/_next/static/webpack.js\" defer=\"\"></script><script src=\"/_next/static/framework.js\" defer=\"\"></script><script src=\"/_next/static/main.js\" defer=\"\"></script><script src=\"/_next/static/pages/_app.js\" defer=\"\"></script><script src=\"/_next/static/d6e1aeb5.js\" defer=\"\"></script><script src=\"/_next/static/4967.js\" defer=\"\"></script><script src=\"/_next/static/9532.js\" defer=\"\"></script><script src=\"/_next/static/7829.js\" defer=\"\"></script><script src=\"/_next/static/2075.js\" defer=\"\"></script><script src=\"/_next/static/6212.js\" defer=\"\"></script><script src=\"/_next/static/1514.js\" defer=\"\"></script><script src=\"/_next/static/2181.js\" defer=\"\"></sc